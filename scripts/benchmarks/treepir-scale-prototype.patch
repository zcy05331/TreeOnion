+std::vector<unsigned char> BatchPIRServer::synthetic_entry(size_t color_index, uint64_t entry_index) const
+{
+    auto mix = [](uint64_t x) -> uint64_t {
+        x += 0x9e3779b97f4a7c15ULL;
+        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+        x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+        return x ^ (x >> 31);
+    };
+
+    uint64_t state = mix((static_cast<uint64_t>(tree_height_) << 48) ^ (static_cast<uint64_t>(color_index) << 40) ^ entry_index);
+    std::vector<unsigned char> entry(batchpir_params_->get_entry_size());
+    for (size_t i = 0; i < entry.size(); ++i) {
+        if ((i % 8) == 0) {
+            state = mix(state + i);
+        }
+        entry[i] = static_cast<unsigned char>((state >> (8 * (i % 8))) & 0xff);
+    }
+    return entry;
+}
+
+void BatchPIRServer::populate_synthetic_buckets()
+{
+    const uint64_t max_bucket = get_max_bucket_size();
+    buckets_.clear();
+    buckets_.resize(tree_height_);
+    for (size_t color_idx = 0; color_idx < buckets_.size(); ++color_idx) {
+        RawDB bucket;
+        if (max_bucket > static_cast<uint64_t>(std::numeric_limits<size_t>::max())) {
+            throw std::runtime_error("synthetic bucket is too large for this platform");
+        }
+        bucket.reserve(static_cast<size_t>(max_bucket));
+        for (uint64_t entry_idx = 0; entry_idx < max_bucket; ++entry_idx) {
+            bucket.push_back(synthetic_entry(color_idx, entry_idx));
+        }
+        buckets_[color_idx].swap(bucket);
+    }
+    batchpir_params_->set_max_bucket_size(max_bucket);
+    print_stats();
+}
