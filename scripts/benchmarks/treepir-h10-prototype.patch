+vector<unsigned char> hex_to_bytes(const string &hex, const string &label)
+{
+    if (hex.size() != kEntrySize * 2) {
+        throw runtime_error(label + " has unexpected hex length");
+    }
+    vector<unsigned char> bytes;
+    bytes.reserve(kEntrySize);
+    for (size_t i = 0; i < hex.size(); i += 2) {
+        string byte_string = hex.substr(i, 2);
+        bytes.push_back(static_cast<unsigned char>(stoi(byte_string, nullptr, 16)));
+    }
+    return bytes;
+}
